<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>PollAssert</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PollAssert.Net</PackageId>
    <Version>0.1.0</Version>
    <Title>PollAssert.NET</Title>
    <Authors>Israel Iyonsi</Authors>
    <Copyright>Copyright (c) 2026 Israel Iyonsi</Copyright>
    <Description>Awaitility for .NET: poll until an asynchronous condition becomes true in tests, with AtMost, PollInterval and Until, built on TimeProvider for deterministic fake-clock testing. Zero external dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/IsraelIyonsi/PollAssert.NET</RepositoryUrl>
    <PackageProjectUrl>https://github.com/IsraelIyonsi/PollAssert.NET</PackageProjectUrl>
    <PackageTags>testing;await;polling;async;timeout;awaitility;xunit;timeprovider;flaky-tests</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/IsraelIyonsi/PollAssert.NET/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PollAssert.Net.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
